# AI Almanac source-development settings.
#
# Copy this file to .env only when you need to override the personal-mode
# defaults used by `pixi run dev` or `pixi run serve`.
#
# Shared deployments use deploy/shared.env.example instead:
#   cp deploy/shared.env.example .env
# See docs/deployment.md for the required security and OIDC configuration.

# Root directory for the personal SQLite database, uploads, job outputs, cache,
# and benchmark environment. Leave empty to use the platform-specific default.
# AI_ALMANAC_DATA_DIR=/absolute/path/to/ai-almanac-data

# `pixi` runs real benchmarks. Use `stub` for synthetic outputs while working
# on the UI or API without the scientific benchmark environment.
RUNNER_MODE=pixi
MAX_LOCAL_JOBS=1

# Browser origin used by FastAPI during source development.
FRONTEND_URL=http://localhost:5173

# Optional OpenAI-compatible or Pydantic AI chat provider. Chat is unavailable
# when LLM_BASE_URL is empty for the default openai-compatible provider.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# Optional Copernicus credentials for datasets that require CDS access.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
