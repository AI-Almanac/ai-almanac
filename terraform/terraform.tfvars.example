# Copy to terraform.tfvars and fill in the two DB passwords; everything else
# below is the real production configuration. terraform.tfvars is gitignored.

project_id = "ai-almanac"
region     = "us-central1"

# Image overrides — leave unset to use the default paths in this project's
# Artifact Registry repo (see locals in artifact_registry.tf). CI owns image
# rollouts; Terraform ignores image changes on the services and migrate jobs.
# app_image  = "us-central1-docker.pkg.dev/ai-almanac/almanac/ai-almanac-web:latest"
# romp_image = "us-central1-docker.pkg.dev/ai-almanac/almanac/romp:latest"

# Cloud SQL — one shared instance; per-env databases/users come from
# modules/almanac-env. Passwords also live in Secret Manager (see README.md).
db_tier             = "db-f1-micro" # upgrade to db-g1-small for production load
db_password         = "CHANGE-ME"
staging_db_password = "CHANGE-ME" # defaults to db_password when omitted

# Domains served by the shared load balancer (SPA + API, same origin). Point
# each domain's A record at the LB IP (see the `lb_ip` output) to provision
# its managed cert.
custom_domain         = "ai-almanac.org"
staging_custom_domain = "staging.ai-almanac.org"

# Frontend origins for the backend CORS allowlist. With the single-image,
# same-origin setup these are effectively informational.
frontend_url         = "https://ai-almanac.org"
staging_frontend_url = "https://staging.ai-almanac.org"

# Auth — the backend runs shared mode with app-level Globus token validation.
# Set at least one admin or the backend refuses to start.
admin_emails = "hholbrook@uchicago.edu"
# admin_subjects = "globus-sub-1,globus-sub-2"

# Job runner and data config
job_runner = "modal"

# Chat assistant / LLM. Leave llm_base_url empty to keep chat disabled.
llm_base_url            = "https://openrouter.ai/api/v1"
llm_model               = "anthropic/claude-haiku-4.5"
enable_run_code         = true
enable_run_code_sandbox = true
