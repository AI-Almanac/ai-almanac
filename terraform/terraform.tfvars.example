project_id  = "your-gcp-project-id"
region      = "us-central1"
ghcr_owner  = "your-github-username-or-org"

# Image overrides — leave unset to use the AR proxy paths derived from ghcr_owner.
# app_image  = "..." # single-process app image (API + bundled SPA), used by prod + staging
# romp_image = "ghcr.io/your-org/romp:latest"  # Cloud Batch pulls this directly

# Cloud SQL
db_tier     = "db-f1-micro"   # upgrade to db-g1-small for production load
db_password = "changeme"      # also stored in Secret Manager after first apply
# staging_db_password defaults to db_password when omitted; set it to isolate
# staging credentials from production.
# staging_db_password = "changeme-staging"

# Domains served by the shared load balancer (SPA + API, same origin). Point
# each domain's A record at the LB IP (see the `lb_ip` output) to provision its
# managed cert.
custom_domain         = "ai-almanac.org"
staging_custom_domain = "staging.ai-almanac.org"

# Frontend origins for the backend CORS allowlist. With the single-image,
# same-origin setup these are effectively informational.
frontend_url         = "https://ai-almanac.org"
staging_frontend_url = "https://staging.ai-almanac.org"

# Auth — the backend runs shared mode with app-level Globus token validation
# (AUTH_MODE=globus, set in cloud_run.tf). Set at least one admin or the backend
# refuses to start. Globus client id/secret and the credential-encryption-key
# are populated in Secret Manager after the first apply (see secrets.tf).
admin_emails = "you@example.com"
# admin_subjects = "globus-sub-1,globus-sub-2"

# Chat assistant / LLM
# Leave llm_base_url empty to keep chat disabled in production.
# llm_base_url            = "https://your-llm-provider.example/v1"
# llm_model               = "claude-sonnet-4-6"
# enable_run_code         = false
# enable_run_code_sandbox = false

# Job output retention (days before GCS auto-deletes outputs)
job_output_retention_days = 30
