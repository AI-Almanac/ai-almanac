node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
# /build itself is tracked via build/.gitkeep — see that file and the root
# .gitignore. Listing the directory rather than its contents would stop Git
# descending into it and make the exception unreachable.
/build/*
!/build/.gitkeep

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
