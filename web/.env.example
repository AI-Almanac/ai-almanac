# Used only when running the Vite frontend separately from FastAPI.
# `pixi run dev` and `pixi run frontend` set this automatically.
VITE_API_URL=http://localhost:8765

# Required for the browser-side Globus PKCE login flow.
VITE_GLOBUS_CLIENT_ID=<thick-client-uuid>
VITE_GLOBUS_REDIRECT_URL=http://localhost:5173/callback
