#!/usr/bin/env bash
# Auto-format staged files (ruff format / prettier --write) and re-stage
# them, then lint. Partially staged files are NOT auto-formatted — restaging
# would sweep unstaged edits into the commit — those fall back to check mode.
# Full checks and tests run on pre-push. Enable with `pixi run install-hooks`;
# bypass with --no-verify.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Files with unstaged modifications on top of staged ones.
unstaged=$(git diff --name-only)

is_partially_staged() {
  echo "$unstaged" | grep -qxF "$1"
}

# Prefer ruff on PATH; fall back to the pixi dev environment.
run_ruff() {
  if command -v ruff >/dev/null 2>&1; then ruff "$@"; else pixi run -e dev ruff "$@"; fi
}

fail=0
formatted=()

# --- Python ------------------------------------------------------------------
mapfile -t py_files < <(echo "$staged" | grep -E '^(src|tests|modal|scripts)/.*\.py$' || true)
for f in "${py_files[@]}"; do
  if is_partially_staged "$f"; then
    if ! run_ruff format --check "$f" >/dev/null 2>&1; then
      echo "pre-commit: $f needs formatting but is partially staged." >&2
      echo "  Stage or stash your remaining edits, or run: pixi run format" >&2
      fail=1
    fi
  else
    run_ruff format "$f" >/dev/null
    formatted+=("$f")
  fi
done
if [ ${#py_files[@]} -gt 0 ]; then
  if ! run_ruff check "${py_files[@]}"; then
    echo "pre-commit: ruff lint failed." >&2
    fail=1
  fi
fi

# --- Web ----------------------------------------------------------------------
mapfile -t web_files < <(echo "$staged" | grep -E '^web/.*\.(ts|js|svelte|css|json|md|html)$' | grep -v 'api-types\.gen\.ts' || true)
prettier_bin="web/node_modules/.bin/prettier"
if [ ${#web_files[@]} -gt 0 ] && [ ! -x "$prettier_bin" ]; then
  echo "pre-commit: skipping prettier (web/node_modules missing; run pixi run install-web)" >&2
elif [ ${#web_files[@]} -gt 0 ]; then
  for f in "${web_files[@]}"; do
    rel=${f#web/}
    if is_partially_staged "$f"; then
      if ! (cd web && ./node_modules/.bin/prettier --check "$rel" >/dev/null 2>&1); then
        echo "pre-commit: $f needs formatting but is partially staged." >&2
        echo "  Stage or stash your remaining edits, or run: pixi run format" >&2
        fail=1
      fi
    else
      (cd web && ./node_modules/.bin/prettier --write "$rel" >/dev/null)
      formatted+=("$f")
    fi
  done
fi

# Re-stage anything we formatted so the commit contains the formatted version.
if [ ${#formatted[@]} -gt 0 ]; then
  git add -- "${formatted[@]}"
  echo "pre-commit: auto-formatted ${#formatted[@]} file(s)"
fi

exit $fail
