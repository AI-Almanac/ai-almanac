# Copy this file to .env and fill in values for your local setup.
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database
# Local dev uses PostgreSQL. When running through docker compose,
# docker-compose.yml overrides DATABASE_URL to use the compose db service:
#   postgresql+asyncpg://almanac:almanac@db:5432/almanac
# Use the localhost URL below when running the backend directly on your host
# against the compose PostgreSQL container.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://almanac:almanac@localhost:5432/almanac

# ---------------------------------------------------------------------------
# Storage backend
# "local" uses the filesystem paths below.
# Set to "gcs" only when testing against real GCP buckets.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
JOB_OUTPUTS_DIR=./job_outputs

# ---------------------------------------------------------------------------
# Job runner
# "docker" runs ROMP locally. Requires Docker and the romp image to be built.
# Set to "batch" only when testing against real GCP Cloud Batch.
# ---------------------------------------------------------------------------
JOB_RUNNER=docker
ROMP_IMAGE=romp:latest
JOB_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Auth
# Leave GLOBUS_CLIENT_ID empty to run in stub mode:
# the raw Bearer token value is used as the user ID (handy for curl testing).
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ALL=true
GLOBUS_CLIENT_ID=
GLOBUS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Demo dataset obs directories — entries defined in backend/app/config/datasets.yaml.
# Pattern: {ID}_OBS_DIR  (ID uppercased, hyphens → underscores)
# Paths are local filesystem paths in dev, gs:// URIs in production.
# Leave unset to hide a dataset from the UI.
# ---------------------------------------------------------------------------
TEST_ETHIOPIA_OBS_DIR=
ETHIOPIA_OBS_DIR=
IMD_2P0_OBS_DIR=

# ---------------------------------------------------------------------------
# Model data directories — entries defined in backend/app/config/models.yaml.
# Pattern: {REGION}_{ID}_MODEL_DIR  (uppercased, hyphens → underscores)
# Leave unset to hide a model from the UI.
# ---------------------------------------------------------------------------
# Test model (synthetic testdata — run scripts/generate_test_data.py first)
TEST_FUXI_TEST_MODEL_DIR=

# India models
INDIA_AIFS_MODEL_DIR=
INDIA_AIFS_DAILY_MODEL_DIR=
INDIA_IFS_MODEL_DIR=
INDIA_NEURALGCM_MODEL_DIR=
INDIA_FUXI_MODEL_DIR=
INDIA_GRAPHCAST_MODEL_DIR=
INDIA_GENCAST_MODEL_DIR=
INDIA_FUXI_S2S_MODEL_DIR=

# Ethiopia models
ETHIOPIA_AIFS_MODEL_DIR=
ETHIOPIA_FUXI_MODEL_DIR=
ETHIOPIA_GRAPHCAST_MODEL_DIR=
ETHIOPIA_GENCAST_MODEL_DIR=

# Full local ROMP data defaults for docker compose:
# ETHIOPIA_OBS_DIR=/romp-data/ethiopia/obs
# IMD_2P0_OBS_DIR=/romp-data/india/imd_rainfall_data/2p0
# INDIA_AIFS_MODEL_DIR=/romp-data/india/aifs
# INDIA_AIFS_DAILY_MODEL_DIR=/romp-data/india/aifs_daily
# INDIA_IFS_MODEL_DIR=/romp-data/india/ifs
# INDIA_NEURALGCM_MODEL_DIR=/romp-data/india/neuralgcm
# INDIA_FUXI_MODEL_DIR=/romp-data/india/fuxi
# INDIA_GRAPHCAST_MODEL_DIR=/romp-data/india/graphcast
# INDIA_GENCAST_MODEL_DIR=/romp-data/india/gencast
# INDIA_FUXI_S2S_MODEL_DIR=/romp-data/india/fuxi_s2s
# ETHIOPIA_AIFS_MODEL_DIR=/romp-data/ethiopia/aifs
# ETHIOPIA_FUXI_MODEL_DIR=/romp-data/ethiopia/fuxi
# ETHIOPIA_GRAPHCAST_MODEL_DIR=/romp-data/ethiopia/graphcast
# ETHIOPIA_GENCAST_MODEL_DIR=/romp-data/ethiopia/gencast

# ---------------------------------------------------------------------------
# LLM chat assistant
# LLM_PROVIDER=openai-compatible uses LLM_BASE_URL with an OpenAI-compatible endpoint
# such as OpenRouter, Ollama, vLLM, or Modal. Leave LLM_BASE_URL empty to disable chat.
# LLM_PROVIDER=pydantic-ai treats LLM_MODEL as a provider-prefixed Pydantic AI model string.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=60
LLM_HISTORY_MAX_MESSAGES=80
CHAT_FIGURE_SIGNING_SECRET=
ENABLE_RUN_CODE=false
ENABLE_RUN_CODE_SANDBOX=false

# ---------------------------------------------------------------------------
# GCP settings — only needed when STORAGE_BACKEND=gcs or JOB_RUNNER=batch
# ---------------------------------------------------------------------------
GCP_PROJECT=
GCP_REGION=us-central1
GCS_DATA_BUCKET=
GCS_UPLOADS_BUCKET=
GCS_OUTPUTS_BUCKET=
BATCH_WORKER_SA=
