{
  "permissions": {
    "allow": [
      "Bash(journalctl -b *)",
      "Bash(journalctl -k *)",
      "Bash(journalctl --list-boots *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi -L *)",
      "Bash(nvidia-smi --query-gpu=*)",
      "Bash(docker info)",
      "Bash(docker info *)",
      "Bash(pixi run check)",
      "Bash(pixi run test)",
      "Bash(docker context ls)",
      "Bash(docker context ls *)",
      "Bash(getent group *)",
      "Bash(dpkg --print-architecture)"
    ],
    "deny": [
      "Read(.env)",
      "Read(web/.env)",
      "Read(**/*service-account*.json)",
      "Read(**/*.pem)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(web/src/lib/api-types.gen.ts)",
      "Bash(gcloud secrets*)",
      "Bash(cat .env*)",
      "Bash(cat web/.env*)"
    ]
  },
  "sandbox": {
    "enabled": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_edited.py\""
          }
        ]
      }
    ]
  }
}
