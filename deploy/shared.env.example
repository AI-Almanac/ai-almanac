PUBLIC_HOST=almanac.example.org
AI_ALMANAC_DATA_DIR=/data
DEPLOYMENT_MODE=shared
AUTH_MODE=proxy
DATABASE_URL=postgresql+psycopg://almanac:change-me@postgres:5432/almanac
POSTGRES_PASSWORD=change-me
ALLOWED_GROUPS=ai-almanac-users
ADMIN_GROUPS=ai-almanac-admins
DATASET_MOUNT_ROOTS=/datasets
FRONTEND_URL=https://almanac.example.org
CREDENTIAL_ENCRYPTION_KEY=replace-with-urlsafe-base64-encoded-32-byte-key
CHAT_FIGURE_SIGNING_SECRET=replace-with-a-random-secret
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_REDIRECT_URL=https://almanac.example.org/oauth2/callback
